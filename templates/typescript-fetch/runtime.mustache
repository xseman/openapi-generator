/**
 * Converts a member of a union by the value of its discriminator property, with the function the
 * value names; a value no function is named for, or null, stays as it is.
 */
export function discriminate(value: any, property: string, by: { [value: string]: (value: any) => any }): any {
    const fn = value == null ? undefined : by[value[property]];
    return fn ? fn(value) : value;
}

/**
 * The keys of a value other than the given ones, with their values: what a model holds next to
 * its properties.
 */
export function otherKeys(value: any, keys: string[]): { [key: string]: any } {
    const result: { [key: string]: any } = {};
    for (const key of Object.keys(value)) {
        if (!keys.includes(key)) {
            result[key] = value[key];
        }
    }
    return result;
}

/**
 * A member of a union converted by the model it fits best: of the models whose required keys the
 * value has, the one that declares the most of its keys and the fewest it does not. A list fits a
 * list member by all its items. undefined when the value is no object (an id next to the object it
 * expands to) or fits none.
 */
export function bestFit(value: any, models: Array<[string[], string[], (value: any) => any, boolean?]>): any {
    const list = Array.isArray(value);
    const items: any[] = list ? value : [value];
    if (value === null || typeof value !== "object" || items.some((item) => item === null || typeof item !== "object" || Array.isArray(item))) {
        return undefined;
    }
    let best: ((value: any) => any) | undefined;
    let score = -Infinity;
    for (const [required, known, fn, array] of models) {
        const fits = !!array === list && items.every((item) => required.every((key) => key in item));
        const fit = items.reduce((n, item) => n + Object.keys(item).reduce((m, key) => m + (known.includes(key) ? 1 : -1), 0), 0);
        if (fits && fit > score) {
            best = fn;
            score = fit;
        }
    }
    return best && (list ? value.map(best) : best(value));
}

export function mapValues(data: any, fn: (item: any) => any): { [key: string]: any } {
    const result: { [key: string]: any } = {};
    for (const key of Object.keys(data)) {
        result[key] = fn(data[key]);
    }
    return result;
}
{{/withoutRuntimeChecks}}

export function canConsumeForm(consumes: Consume[]): boolean {
    for (const consume of consumes) {
        if (consume.contentType?.startsWith("multipart/form-data") == true) {
            return true;
        }
    }
    return false;
}

export interface Consume {
    contentType: string;
}

export interface RequestContext {
    fetch: FetchAPI;
    url: string;
    init: RequestInit;
}

export interface ResponseContext {
    fetch: FetchAPI;
    url: string;
    init: RequestInit;
    response: Response;
}

export interface ErrorContext {
    fetch: FetchAPI;
    url: string;
    init: RequestInit;
    error: unknown;
    response?: Response;
}

export interface Middleware {
    pre?(context: RequestContext): Promise<FetchParams | void>;
    post?(context: ResponseContext): Promise<Response | void>;
    onError?(context: ErrorContext): Promise<Response | void>;
}

/**
 * API response wrapper that provides both raw response and typed value.
 * 
 * @example
 * ```typescript
 * const response = await api.getUserRaw({ userId: "123" });
 * console.log(response.raw.status); // 200
 * const user = await response.value(); // Typed User object
 * ```
 */
export interface ApiResponse<T> {
    raw: Response;
    value(): Promise<T>;
}

export interface ResponseTransformer<T> {
    (json: any): T;
}

export class JSONApiResponse<T> {
    constructor(public raw: Response, private transformer: ResponseTransformer<T> = (jsonValue: any) => jsonValue) {}

    /**
     * The body parsed and converted; null when there is none, as a 204 next to a 200 with a body
     * or the answer to a HEAD has.
     */
    async value(): Promise<T> {
        const text = await this.raw.text();
        return text === "" ? (null as T) : this.transformer(JSON.parse(text));
    }
}

export class VoidApiResponse {
    constructor(public raw: Response) {}

    async value(): Promise<void> {
        return undefined;
    }
}

/**
 * A Blob carrying the file name the server advertised, empty when it did not send one. It is a File
 * wherever one can be built, and the bare Blob given a name otherwise. Same name and shape as the
 * `typescript` generator's browser HttpFile.
 */
export type HttpFile = Blob & { readonly name: string };

export class BlobApiResponse {
    constructor(public raw: Response) {}

    /**
     * The body named after the Content-Disposition header, so that a download keeps the name the
     * server gave it. A File is built from a native Blob; the Blob itself is named where there is no
     * global File (Node.js before 20), where File cannot be constructed, or where the Blob is not the
     * native one, as returned by an injected fetch implementation such as node-fetch, which a File
     * would stringify instead of wrapping.
     */
    async value(): Promise<HttpFile> {
        const blob = await this.raw.blob();
        const name = parseContentDispositionFilename(this.raw.headers) ?? '';
        if (typeof File !== 'undefined' && blob instanceof Blob) {
            try {
                return new File([blob], name, { type: blob.type });
            } catch {
                // File cannot be constructed: name the Blob itself
            }
        }
        return Object.assign(blob, { name });
    };
}

/**
 * The file name advertised by a Content-Disposition header (RFC 6266): the RFC 5987 encoded
 * `filename*` parameter first, falling back to the plain `filename` when it is malformed, not UTF-8
 * or has no usable name. Any directory part is dropped; undefined when no usable name is advertised.
 */
export function parseContentDispositionFilename(headers: Headers): string | undefined {
    const params = parseHeaderParameters(headers.get('Content-Disposition') ?? '');
    return basename(decodeExtValue(params.get('filename*'))) ?? basename(params.get('filename'));
}

/** The decoded RFC 5987 ext-value, or undefined when it is not UTF-8 or its percent-encoding is malformed. */
function decodeExtValue(value: string | undefined): string | undefined {
    const match = value === undefined ? null : /^utf-8'[^']*'(.*)$/i.exec(value);
    try {
        return match ? decodeURIComponent(match[1]) : undefined;
    } catch {
        return undefined;
    }
}

/**
 * The `name=value` parameters of a header value, consumed one at a time so that a quoted-string is
 * taken whole, `;` included. Names are lower-cased, quoted-string values are unquoted with their
 * backslash escapes resolved, and the first occurrence of a name wins.
 */
function parseHeaderParameters(value: string): Map<string, string> {
    const params = new Map<string, string>();
    const parameter = /(?:^|;)\s*([^=;]+?)\s*=\s*(?:"((?:[^"\\]|\\.)*)"?|([^;]*))/g;
    let match: RegExpExecArray | null;
    while ((match = parameter.exec(value)) !== null) {
        const name = match[1].toLowerCase();
        if (!params.has(name)) {
            params.set(name, match[2] !== undefined ? match[2].replace(/\\(.)/g, '$1') : match[3].trim());
        }
    }
    return params;
}

/** The last `/` or `\` separated segment of a file name, or undefined when it is not a file name. */
function basename(name: string | undefined): string | undefined {
    const base = name?.split(/[\\/]/).pop();
    return !base || base === '.' || base === '..' ? undefined : base;
}

/**
 * A server-sent event: its data as the item type (parsed from JSON unless the item is text), its
 * event name, id and retry when the server sent them. An id stays the id of the events after it,
 * as the specification has it.
 */
export interface ServerSentEvent<T> {
    data: T;
    event?: string;
    id?: string;
    retry?: number;
}

/**
 * A streamed body, read as it arrives: the JSON value of each line of JSON Lines ("lines"), or each
 * server-sent event ("events"), converted by the transformer. The response stays open until the loop
 * over the value ends or breaks, or the request's signal aborts it.
 */
export class StreamApiResponse<T> {
    constructor(public raw: Response, private kind: "lines" | "events", private transformer: (value: any) => any) {}

    async value(): Promise<AsyncIterable<T>> {
        return (this.kind === "lines" ? jsonLines(this.raw, this.transformer) : serverSentEvents(this.raw, this.transformer)) as AsyncIterable<T>;
    }
}

/** The lines of a body as they arrive, without their line endings; the last one also without one. */
async function* bodyLines(raw: Response): AsyncGenerator<string> {
    if (raw.body == null) {
        return;
    }
    const reader = raw.body.getReader();
    const decoder = new TextDecoder();
    let buffer = "";
    try {
        for (;;) {
            const { done, value } = await reader.read();
            buffer += done ? decoder.decode() : decoder.decode(value, { stream: true });
            let end: number;
            while ((end = buffer.search(/\r\n|\r|\n/)) >= 0) {
                const newline = buffer.startsWith("\r\n", end) ? 2 : 1;
                yield buffer.slice(0, end);
                buffer = buffer.slice(end + newline);
            }
            if (done) {
                break;
            }
        }
        if (buffer !== "") {
            yield buffer;
        }
    } finally {
        // A loop that breaks early closes the response.
        await reader.cancel().catch(() => undefined);
    }
}

async function* jsonLines(raw: Response, transformer: (value: any) => any): AsyncGenerator<any> {
    for await (const line of bodyLines(raw)) {
        if (line.trim() !== "") {
            yield transformer(JSON.parse(line));
        }
    }
}

/**
 * The events of a text/event-stream (the HTML living standard's parser): data lines joined by a
 * newline, a byte order mark and comments skipped, an event the stream ends in the middle of dropped.
 */
async function* serverSentEvents(raw: Response, transformer: (value: any) => any): AsyncGenerator<ServerSentEvent<any>> {
    let data: string[] = [];
    let event: string | undefined;
    let id: string | undefined;
    let retry: number | undefined;
    let first = true;
    for await (let line of bodyLines(raw)) {
        if (first && line.startsWith("\uFEFF")) {
            line = line.slice(1);
        }
        first = false;
        if (line === "") {
            if (data.length > 0) {
                const e: ServerSentEvent<any> = { data: transformer(data.join("\n")) };
                if (event !== undefined) {
                    e.event = event;
                }
                if (id !== undefined) {
                    e.id = id;
                }
                if (retry !== undefined) {
                    e.retry = retry;
                }
                yield e;
            }
            data = [];
            event = undefined;
            continue;
        }
        if (line.startsWith(":")) {
            continue;
        }
        const colon = line.indexOf(":");
        const field = colon < 0 ? line : line.slice(0, colon);
        const value = colon < 0 ? "" : line.slice(colon + 1).replace(/^ /, "");
        switch (field) {
            case "data":
                data.push(value);
                break;
            case "event":
                event = value;
                break;
            case "id":
                if (!value.includes("\0")) {
                    id = value;
                }
                break;
            case "retry":
                if (/^\d+$/.test(value)) {
                    retry = Number(value);
                }
                break;
        }
    }
}

export class TextApiResponse {
    constructor(public raw: Response) {}

    async value(): Promise<string> {
        return await this.raw.text();
    }
}

// Helper conversion functions
export function anyFromJSON(json: any): any {
    return json;
}

export function anyToJSON(value: any): any {
    return value;
}

export function BlobFromJSON(json: any): Blob {
    if (typeof json === 'string') {
        // Assume base64 encoded
        const byteCharacters = atob(json);
        const byteNumbers = new Array(byteCharacters.length);
        for (let i = 0; i < byteCharacters.length; i++) {
            byteNumbers[i] = byteCharacters.charCodeAt(i);
        }
        const byteArray = new Uint8Array(byteNumbers);
        return new Blob([byteArray]);
    }
    return json;
}

export function BlobToJSON(value: Blob | null | undefined): any {
    return value;
}

export function FromJSON<T>(json: any): T {
    return json as T;
}
