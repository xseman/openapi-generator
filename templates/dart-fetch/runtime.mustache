/// Default [HttpSender] backed by `dart:io`'s [HttpClient].
///
/// Usable on the Dart VM and Flutter mobile/desktop. For browser targets,
/// supply a custom sender via [Configuration.httpSender].
Future<HttpResponse> defaultHttpSender(HttpRequest req) async {
    final client = HttpClient();
    try {
        final dartReq = await client.openUrl(req.method.value, req.url);
        req.headers.forEach(dartReq.headers.add);

        final body = req.body;
        if (body is String) {
            dartReq.add(utf8.encode(body));
        } else if (body is List<int>) {
            dartReq.add(body);
        }

        final dartRes = await dartReq.close();
        final headers = <String, String>{};
        dartRes.headers.forEach((name, values) => headers[name] = values.join(', '));

        final streamed = req.stream && dartRes.statusCode >= 200 && dartRes.statusCode < 300;

        return HttpResponse(
            statusCode: dartRes.statusCode,
            headers: headers,
            body: streamed ? const <int>[] : await _collectBytes(dartRes),
            stream: streamed ? dartRes : null,
        );
    } finally {
        client.close(force: false);
    }
}

Future<List<int>> _collectBytes(Stream<List<int>> stream) async {
    final builder = BytesBuilder(copy: false);
    await for (final chunk in stream) {
        builder.add(chunk);
    }
    return builder.takeBytes();
}
