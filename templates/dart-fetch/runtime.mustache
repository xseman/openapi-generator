import 'dart:math';
import 'dart:typed_data';

/// Default base path for this client.
const String basePath = '{{basePath}}';

/// HTTP methods supported by the generated APIs.
enum HttpMethod {
    get,
    post,
    put,
    delete,
    patch,
    head,
    options;

    /// The uppercase string value used in the actual HTTP request (e.g. `'GET'`).
    String get value => name.toUpperCase();
}

/// A request prepared by an API method but not yet dispatched.
class HttpRequest {
    HttpRequest({
        required this.method,
        required this.url,
        Map<String, String>? headers,
        this.body,
        this.stream = false,
    }) : headers = Map<String, String>.from(headers ?? const <String, String>{});

    final HttpMethod method;
    final Uri url;
    final Map<String, String> headers;

    /// Encoded request body. May be null, a String, or a `List<int>`.
    Object? body;

    /// Whether a 2xx response is handed over unread, as [HttpResponse.stream]:
    /// the operation reads its items as they arrive.
    final bool stream;

    HttpRequest copyWith({
        HttpMethod? method,
        Uri? url,
        Map<String, String>? headers,
        Object? body,
    }) => HttpRequest(
        method: method ?? this.method,
        url: url ?? this.url,
        headers: headers ?? this.headers,
        body: body ?? this.body,
        stream: stream,
    );
}

/// A raw HTTP response returned by an [HttpSender].
class HttpResponse({
    required final int statusCode,
    required final Map<String, String> headers,
    required final List<int> body,
    /// The body as it arrives, in place of [body], for a request that asked
    /// to [HttpRequest.stream].
    final Stream<List<int>>? stream,
}) {
    String get bodyString => utf8.decode(body, allowMalformed: true);

    /// The media type of the body, without its parameters; JSON when the
    /// server names none.
    String get mediaType => (headers['content-type'] ?? 'application/json').split(';').first.trim().toLowerCase();

    bool get _isJson => mediaType == 'application/json' || mediaType.endsWith('+json');

    bool get _isText => mediaType.startsWith('text/') || ['json', 'xml', 'urlencoded'].any(mediaType.contains);

    /// The body as a JSON value, null when empty. Plain text is read as the
    /// JSON it holds, a number say, else as text; another text media type
    /// is its text, anything else its bytes.
    Object? get bodyJson {
        if (body.isEmpty) return null;
        if (!_isText) return Uint8List.fromList(body);

        final text = bodyString;
        if (_isJson) return jsonDecode(text);
        if (mediaType != 'text/plain') return text;

        try {
            return jsonDecode(text);
        } on FormatException {
            return text;
        }
    }

    /// The body of a text result: JSON sends it quoted, another media type
    /// as it is.
    String get bodyText => _isJson ? bodyJson as String : bodyString;

    bool get isSuccessful => statusCode >= 200 && statusCode < 300;
}

/// Function signature for a pluggable HTTP transport.
typedef HttpSender = Future<HttpResponse> Function(HttpRequest request);

/// Hook invoked before a request is sent. May return a modified request.
typedef PreMiddleware = FutureOr<HttpRequest> Function(HttpRequest request);

/// Hook invoked after a response is received. May return a modified response.
typedef PostMiddleware = FutureOr<HttpResponse> Function(
    HttpRequest request,
    HttpResponse response,
);

/// Hook invoked when sending a request fails. May rethrow or return a fallback.
typedef ErrorMiddleware = FutureOr<HttpResponse?> Function(
    HttpRequest request,
    Object error,
    StackTrace stackTrace,
);

/// Composable middleware applied around every request.
class Middleware({
    final PreMiddleware? pre,
    final PostMiddleware? post,
    final ErrorMiddleware? onError,
});

/// Client configuration.
///
/// All fields are optional. The defaults assume a Dart VM / Flutter
/// environment with `dart:io` available.
class Configuration {
    Configuration({
        String? basePath,
        Map<String, String>? headers,
        this.username,
        this.password,
        this.apiKey,
        this.accessToken,
        HttpSender? httpSender,
        List<Middleware>? middleware,
    })  : basePath = basePath ?? _defaultBasePath,
                headers = Map<String, String>.from(headers ?? const <String, String>{}),
                httpSender = httpSender ?? defaultHttpSender,
                middleware = List<Middleware>.unmodifiable(middleware ?? const <Middleware>[]);

    static const String _defaultBasePath = '{{basePath}}';

    final String basePath;
    final Map<String, String> headers;
    final String? username;
    final String? password;

    /// Returns an API key for the given header/query parameter name.
    final String Function(String name)? apiKey;

    /// Returns a bearer token (e.g. for OAuth2).
    final String Function()? accessToken;

    final HttpSender httpSender;
    final List<Middleware> middleware;
}

/// Thrown when the server returns a non-2xx status, or a 2xx one whose body
/// is of another type than the operation's result.
class ApiException(
    final int statusCode,
    final String message, {
    final String? body,
    final Map<String, String>? headers,
}) implements Exception {
    @override
    String toString() => 'ApiException($statusCode): $message';
}

/// Base class for all generated API classes.
class BaseApi(final Configuration configuration) {
    /// The [Uri] of [path], its parameters already written in, under the
    /// configuration's base path, with [queryParams] as its query string.
    Uri buildUri(String path, {Map<String, List<String>>? queryParams}) {
        final base = Uri.parse(configuration.basePath);
        final basePath = base.path.endsWith('/') ? base.path.substring(0, base.path.length - 1) : base.path;
        final query = <String, List<String>>{...base.queryParametersAll, ...?queryParams};

        return base.replace(path: basePath + path, queryParameters: query.isEmpty ? null : query);
    }

    /// Sends [req] through configured middleware and the [HttpSender],
    /// returning the raw [HttpResponse].
    Future<HttpResponse> request(HttpRequest req) async {
        final merged = <String, String>{
            ...configuration.headers,
            ...req.headers,
        };
        var current = req.copyWith(headers: merged);

        for (final m in configuration.middleware) {
            if (m.pre case final pre?) {
                current = await pre(current);
            }
        }

        HttpResponse response;
        try {
            response = await configuration.httpSender(current);
        } catch (e, st) {
            HttpResponse? fallback;
            for (final m in configuration.middleware) {
                if (m.onError case final onError?) {
                    fallback = await onError(current, e, st);
                    if (fallback != null) break;
                }
            }
            if (fallback == null) rethrow;
            response = fallback;
        }

        for (final m in configuration.middleware) {
            if (m.post case final post?) {
                response = await post(current, response);
            }
        }

        if (!response.isSuccessful) {
            throw ApiException(
                response.statusCode,
                'HTTP ${response.statusCode}',
                body: response.bodyString,
                headers: response.headers,
            );
        }

        return response;
    }

}

/// The text of a scalar [value] in a parameter; a list or an object inside
/// one stays JSON, null is empty.
String paramText(Object? value) {
    if (value == null) return '';
    if (value is DateTime) return value.toUtc().toIso8601String();
    if (value is List || value is Map) return jsonEncode(value);
    // A whole number without the exponent toString gives a large one.
    if (value is double && value.isFinite && value == value.truncateToDouble()) return BigInt.from(value).toString();

    return value.toString();
}

/// Whether a parameter leaves [value] out: null, an empty list or object.
bool _absent(Object? value) => value == null || (value is List && value.isEmpty) || (value is Map && value.isEmpty);

/// The keys of [object], sorted, and the text of their values.
List<(String, String)> _pairs(Map<dynamic, dynamic> object) =>
    [for (final key in object.keys.map((k) => '$k').toList()..sort()) (key, paramText(object[key]))];

/// Adds the parameter [name] holding [value], JSON as an API method wrote
/// it, to [query] in the OpenAPI [style] (form, spaceDelimited,
/// pipeDelimited, deepObject).
void addQuery(Map<String, List<String>> query, String name, Object? value, String style, bool explode) {
    if (_absent(value)) return;

    void add(String key, String text) => query.putIfAbsent(key, () => <String>[]).add(text);

    // deepObject spells nested objects and lists out a key at a time:
    // name[a][b]=x, name[list][0]=y; a null leaves its key out.
    void addTree(String key, Object? node) {
        if (node is Map) {
            for (final k in node.keys.map((k) => '$k').toList()..sort()) {
                addTree('$key[$k]', node[k]);
            }
        } else if (node is List) {
            for (var i = 0; i < node.length; i++) {
                addTree('$key[$i]', node[i]);
            }
        } else if (node != null) {
            add(key, paramText(node));
        }
    }

    if (value is! List && value is! Map) return add(name, paramText(value));
    if (style == 'deepObject') return addTree(name, value);

    if (value is List) {
        final items = value.map(paramText);
        final separator = switch (style) { 'spaceDelimited' => ' ', 'pipeDelimited' => '|', _ => ',' };

        for (final item in explode ? items : [items.join(separator)]) {
            add(name, item);
        }

        return;
    }

    final pairs = _pairs(value as Map);

    for (final (key, text) in explode ? pairs : [(name, pairs.map((pair) => '${pair.$1},${pair.$2}').join(','))]) {
        add(key, text);
    }
}

/// The text of [value] for the path parameter [name] in the OpenAPI [style]
/// (simple, label, matrix), each value escaped on its own.
String pathParam(Object? value, String name, String style, bool explode) {
    if (_absent(value)) return '';

    const escape = Uri.encodeComponent;
    final pairs = value is Map ? [for (final (k, v) in _pairs(value)) (escape(k), escape(v))] : null;
    final values = value is List ? value.map((item) => escape(paramText(item))) : [escape(paramText(value))];

    var (prefix, separator) = ('', ',');
    if (style == 'label') (prefix, separator) = ('.', explode ? '.' : ',');
    if (style == 'matrix') {
        prefix = ';${escape(name)}=';
        if (explode) (prefix, separator) = (pairs == null ? prefix : ';', pairs == null ? prefix : ';');
    }

    if (pairs == null) return prefix + values.join(separator);
    if (explode) return prefix + pairs.map((pair) => '${pair.$1}=${pair.$2}').join(separator);

    return prefix + pairs.map((pair) => '${pair.$1},${pair.$2}').join(',');
}

/// The text of [value] for a header or cookie parameter (simple style),
/// null when there is nothing to send.
String? _headerText(Object? value, bool explode) {
    if (_absent(value)) return null;
    if (value is List) return value.map(paramText).join(',');
    if (value is! Map) return paramText(value);

    return _pairs(value).map((pair) => '${pair.$1}${explode ? '=' : ','}${pair.$2}').join(',');
}

/// Sets the header [name] of [headers] to [value], unless it is absent.
void setHeader(Map<String, String> headers, String name, Object? value, bool explode) {
    if (_headerText(value, explode) case final text?) headers[name] = text;
}

/// Adds the cookie [name] to the Cookie header of [headers], unless
/// [value] is absent.
void addCookie(Map<String, String> headers, String name, Object? value, bool explode) {
    final text = _headerText(value, explode);
    if (text == null) return;

    headers.update('Cookie', (cookies) => '$cookies; $name=$text', ifAbsent: () => '$name=$text');
}

/// The value of a property that is optional and nullable, when its key is
/// present: [value] is null for a JSON null. The property itself is null
/// when the key is absent.
class Opt<T extends Object>(final T? value);

/// The items of a JSON Lines response, each read by [item] from its JSON.
Stream<T> decodeLines<T>(HttpResponse response, T Function(Object? json) item) => (response.stream ?? Stream.value(response.body))
    .transform(utf8.decoder)
    .transform(const LineSplitter())
    .where((line) => line.trim().isNotEmpty)
    .map((line) => item(jsonDecode(line)));

/// A server-sent event: its data, and the fields the server sent with it.
class ServerSentEvent<T>({final T? data, final String? event, final String? id, final int? retry});

/// The events of a text/event-stream response, the data of each read by
/// [data] from its text. An id stays for the events after it, as a browser
/// keeps it.
Stream<ServerSentEvent<T>> decodeEvents<T>(HttpResponse response, T Function(String text) data) async* {
    final lines = (response.stream ?? Stream.value(response.body)).transform(utf8.decoder).transform(const LineSplitter());
    final text = <String>[];
    String? event, id;
    int? retry;

    await for (final line in lines) {
        if (line.isEmpty) {
            if (text.isNotEmpty) yield ServerSentEvent(data: data(text.join('\n')), event: event, id: id, retry: retry);

            text.clear();
            (event, retry) = (null, null);

            continue;
        }

        final colon = line.indexOf(':');
        if (colon == 0) continue; // a comment

        final field = colon < 0 ? line : line.substring(0, colon);
        var value = colon < 0 ? '' : line.substring(colon + 1);
        if (value.startsWith(' ')) value = value.substring(1);

        switch (field) {
            case 'data':
                text.add(value);
            case 'event':
                event = value;
            case 'id':
                id = value;
            case 'retry':
                retry = int.tryParse(value);
        }
    }
}

/// A file in a multipart request.
class UploadFile(final List<int> bytes, {final String? filename});

/// The body of a multipart/form-data request, a part at a time.
class Multipart {
    final String _boundary = 'dart-${List.generate(4, (_) => Random().nextInt(1 << 32).toRadixString(16)).join()}';
    final BytesBuilder _body = BytesBuilder(copy: false);

    /// The Content-Type header that names the boundary of [close]'s bytes.
    String get contentType => 'multipart/form-data; boundary=$_boundary';

    /// Adds the form field [name] holding [value]: an [UploadFile] as a file
    /// part, a list of them as one part each, a list of scalars one part
    /// each (one comma-separated part unless [explode]), an object as a JSON
    /// part; nothing for an absent value.
    void add(String name, Object? value, bool explode) {
        if (_absent(value)) return;

        if (value is UploadFile) return _part(name, value.bytes, filename: value.filename ?? name);
        if (value is! List && value is! Map) return _part(name, utf8.encode(paramText(value)));

        if (value is List<UploadFile>) {
            for (final file in value) {
                add(name, file, explode);
            }

            return;
        }

        if (value is List && value.every((item) => item is! List && item is! Map)) {
            final items = value.map(paramText);

            for (final item in explode ? items : [items.join(',')]) {
                _part(name, utf8.encode(item));
            }

            return;
        }

        _part(name, utf8.encode(jsonEncode(value)), contentType: 'application/json');
    }

    void _part(String name, List<int> bytes, {String? filename, String? contentType}) {
        String quoted(String text) => text.replaceAll(r'\', r'\').replaceAll('"', r'\"');

        final file = filename == null ? '' : '; filename="${quoted(filename)}"';
        final type = contentType ?? (filename == null ? null : 'application/octet-stream');

        _body.add(utf8.encode('--$_boundary\r\nContent-Disposition: form-data; name="${quoted(name)}"$file\r\n'));
        if (type != null) _body.add(utf8.encode('Content-Type: $type\r\n'));
        _body.add(utf8.encode('\r\n'));
        _body.add(bytes);
        _body.add(utf8.encode('\r\n'));
    }

    /// The bytes of the body, after its last part.
    Uint8List close() {
        _body.add(utf8.encode('--$_boundary--\r\n'));

        return _body.takeBytes();
    }
}

/// The day of [value] as OpenAPI's `date` writes it, 2024-01-31.
String formatDate(DateTime value) => value.toIso8601String().substring(0, 10);

/// Encodes [form], filled by [addQuery], as
/// `application/x-www-form-urlencoded`.
String encodeFormData(Map<String, List<String>> form) => [
    for (final MapEntry(:key, value: values) in form.entries)
        for (final value in values) '${Uri.encodeQueryComponent(key)}=${Uri.encodeQueryComponent(value)}',
].join('&');

/// Helpers for primitive deserialization used by generated models.
DateTime? dateTimeFromJson(Object? json) {
    if (json == null) return null;
    return DateTime.parse(json as String);
}

Object? dateTimeToJson(DateTime? value) {
    if (value == null) return null;
    return value.toUtc().toIso8601String();
}

