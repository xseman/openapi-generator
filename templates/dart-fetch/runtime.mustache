/// No default [HttpSender] is bundled with this client.
///
/// Supply one explicitly via [Configuration.httpSender]. Until you do,
/// every request will throw [UnimplementedError].
Future<HttpResponse> defaultHttpSender(HttpRequest req) =>
        throw UnimplementedError(
            'No HttpSender configured. Pass one to Configuration(httpSender: ...).',
        );
